{
code = "featureNames {
   name \"SS01: Equal Symbols\"; 
};

lookupflag IgnoreMarks;

lookup equal_equal_equal {
  # Contextual substitution for '===' not followed or preceded by '='.
  ignore sub equal equal' equal equal;
  ignore sub equal' equal equal equal;
  sub equal' equal' equal' by equal_equal_equal;
} equal_equal_equal;

lookup exclam_equal_equal {
  # Contextual substitution for '!==' not followed by '='.
  ignore sub exclam' equal equal equal;
  sub exclam' equal' equal' by exclam_equal_equal;
} exclam_equal_equal;

lookup equal_exclam_equal {
    # Contextual substitution for '=!=' not followed or preceded by '=' or '!'.
    ignore sub equal' exclam equal [equal exclam];
    ignore sub [equal exclam] equal' exclam equal;
    sub equal' exclam' equal' by equal_exclam_equal;
} equal_exclam_equal;

lookup equal_slash_equal {
  # Contextual substitution for '=/=' not followed or preceded by '='.
  ignore sub equal equal' slash equal;
  ignore sub equal' slash equal equal;
  sub equal' slash' equal' by equal_slash_equal;
} equal_slash_equal;

lookup slash_equal_equal {
  # Contextual substitution for '/==' not followed by '='.
  ignore sub slash' equal equal equal;
  sub slash' equal' equal' by slash_equal_equal;
} slash_equal_equal;

lookup slash_equal {
  # Contextual substitution for '/='.
  sub slash' equal' by slash_equal;
} slash_equal;

lookup numbersign_equal {
  # Contextual substitution for '#='.
  sub numbersign' equal' by numbersign_equal;
} numbersign_equal;

lookup ampersand_equal {
  # Contextual substitution for '&='.
  sub [ampersand ampersand.left ampersand.right ampersand.both]' equal' by ampersand_equal;
} ampersand_equal;

lookup equal_equal {
  # Contextual substitution for '==' not followed or preceded by '='.
  ignore sub equal equal' equal;
  ignore sub equal' equal equal;
  sub equal' equal' by equal_equal;
} equal_equal;

lookup exclam_equal {
  # Contextual substitution for '!=' not followed by '='.
  ignore sub exclam' equal equal;
  sub exclam' equal' by exclam_equal;
} exclam_equal;

lookup asciitilde_asciitilde {
  # Contextual substitution for '~~' not followed or preceded by '~', '<' or '>'.
  ignore sub asciitilde' asciitilde asciitilde;
  ignore sub asciitilde asciitilde' asciitilde;
  ignore sub asciitilde' asciitilde [greater less];
  ignore sub [greater less] asciitilde' asciitilde;
  sub asciitilde' asciitilde' by asciitilde_asciitilde;
} asciitilde_asciitilde;

lookup equal_asciitilde {
  # Contextual substitution for '=~' not preceded by '=' or followed by '~'.
	ignore sub equal equal' asciitilde;
	ignore sub equal' asciitilde asciitilde;
	ignore sub slash equal' asciitilde;
	ignore sub equal' asciitilde slash;
	sub equal' asciitilde' by equal_asciitilde;
} equal_asciitilde;

lookup exclam_asciitilde {
  # Contextual substitution for '!~' not followed by '~'.
  ignore sub exclam' asciitilde asciitilde;
	sub exclam' asciitilde' by exclam_asciitilde;
} exclam_asciitilde;

lookup asciitilde_hyphen {
  # Contextual substitution for '~-' not followed or preceded by '~' or '-'.
  ignore sub [asciitilde hyphen] asciitilde' hyphen';
  ignore sub asciitilde' hyphen' [asciitilde hyphen];
	sub asciitilde' hyphen' by asciitilde_hyphen;
} asciitilde_hyphen;

lookup hyphen_asciitilde {
  # Contextual substitution for '-~' not followed or preceded by '~' or '-'.
  ignore sub [asciitilde hyphen] hyphen' asciitilde';
  ignore sub hyphen' asciitilde' [asciitilde hyphen];
	sub hyphen' asciitilde' by hyphen_asciitilde;
} hyphen_asciitilde;









lookup ss01_EAW {
    sub equal_equal_equal by emptyAdvanceWidth emptyAdvanceWidth equal_equal_equal;
    sub exclam_equal_equal by emptyAdvanceWidth emptyAdvanceWidth exclam_equal_equal;
    sub equal_exclam_equal by emptyAdvanceWidth emptyAdvanceWidth equal_exclam_equal;
    sub slash_equal_equal by emptyAdvanceWidth emptyAdvanceWidth slash_equal_equal;
    sub equal_slash_equal by emptyAdvanceWidth emptyAdvanceWidth equal_slash_equal;
    sub equal_equal by emptyAdvanceWidth equal_equal;
    sub exclam_equal by emptyAdvanceWidth exclam_equal;
    sub exclam_equal.alt by exclam_equal;
    sub slash_equal by emptyAdvanceWidth slash_equal;
    sub numbersign_equal by emptyAdvanceWidth numbersign_equal;
    sub ampersand_equal by emptyAdvanceWidth ampersand_equal;
    sub asciitilde_asciitilde by emptyAdvanceWidth asciitilde_asciitilde;
    sub equal_asciitilde by emptyAdvanceWidth equal_asciitilde;
    sub exclam_asciitilde by emptyAdvanceWidth exclam_asciitilde;
    sub asciitilde_hyphen by emptyAdvanceWidth asciitilde_hyphen;
    sub hyphen_asciitilde by emptyAdvanceWidth hyphen_asciitilde;
} ss01_EAW;";
tag = ss01;
},
{
code = "featureNames {
   name \"SS02: Comparisons\"; 
};

lookupflag IgnoreMarks;

lookup greater_equal {
    # Contextual substitution for '>=' not followed by '=' and not preceded or followed by '>'.
    ignore sub greater' equal' [greater less equal];
    ignore sub greater greater' equal';
    sub greater' equal' by greater_equal;
} greater_equal;

lookup less_equal {
    # Contextual substitution for '<=' not followed by '=' and not part of '<=>'.
    ignore sub less' equal' equal;
    ignore sub less' equal' [greater less equal];
    ignore sub less less' equal';
    ignore sub less_equal.alt';
    sub less' equal' by less_equal;
} less_equal;








lookup ss02_EAW {
    sub greater_equal by emptyAdvanceWidth greater_equal;
    sub less_equal by emptyAdvanceWidth less_equal;
} ss02_EAW;";
tag = ss02;
