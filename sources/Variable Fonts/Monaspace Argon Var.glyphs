    ignore sub less' hyphen hyphen greater greater;
    sub less' hyphen' hyphen' greater' by less_hyphen_hyphen_greater;
} less_hyphen_hyphen_greater;

lookup less_exclam_hyphen_hyphen {
    # Contextual substitution for '<!--' not followed by '-' or preceded by '<'.
    ignore sub less less' exclam hyphen hyphen;
    ignore sub less' exclam hyphen hyphen hyphen;
    sub less' exclam' hyphen' hyphen' by less_exclam_hyphen_hyphen;
} less_exclam_hyphen_hyphen;

lookup less_hyphen_hyphen {
    # Contextual substitution for '<--' not followed by '-' or '>', or preceded by '<'.
    ignore sub less less' hyphen hyphen;
    ignore sub less' hyphen hyphen hyphen;
    ignore sub less' hyphen hyphen greater;
    sub less' hyphen' hyphen' by less_hyphen_hyphen;
} less_hyphen_hyphen;

lookup hyphen_hyphen_greater {
    # Contextual substitution for '-->' not preceded by '-' or '<', or followed by '>'.
    ignore sub hyphen' hyphen greater greater;
    ignore sub hyphen hyphen' hyphen greater;
    ignore sub less hyphen' hyphen greater;
    sub hyphen' hyphen' greater' by hyphen_hyphen_greater;
} hyphen_hyphen_greater;

lookup less_hyphen_greater {
    # Contextual substitution for '<->' not followed by '>' or preceded by '<'.
    ignore sub less less' hyphen greater;
    ignore sub less' hyphen greater greater;
    sub less' hyphen' greater' by less_hyphen_greater;
} less_hyphen_greater;

lookup less_hyphen {
    # Contextual substitution for '<-' not followed by '>' or preceded by '<'.
    ignore sub less less' hyphen;
    ignore sub less' hyphen greater;
    sub less' hyphen' by less_hyphen;
} less_hyphen;

lookup hyphen_greater {
    # Contextual substitution for '->' not followed by '>' or preceded by '<'.
    ignore sub hyphen' greater greater;
    ignore sub less hyphen' greater;
    sub hyphen' greater' by hyphen_greater;
} hyphen_greater;






lookup less_asciitilde_asciitilde {
    # Contextual substitution for '<~~' not followed by '~' or '>', or preceded by '<'.
    ignore sub less less' asciitilde asciitilde;
    ignore sub less' asciitilde asciitilde asciitilde;
    ignore sub less' asciitilde asciitilde greater;
    sub less' asciitilde' asciitilde' by less_asciitilde_asciitilde;
} less_asciitilde_asciitilde;

lookup asciitilde_asciitilde_greater {
    # Contextual substitution for '~~>' not preceded by '~' or '<', or followed by '>'.
    ignore sub asciitilde' asciitilde greater greater;
    ignore sub asciitilde asciitilde' asciitilde greater;
    ignore sub less asciitilde' asciitilde greater;
    sub asciitilde' asciitilde' greater' by asciitilde_asciitilde_greater;
} asciitilde_asciitilde_greater;

lookup less_asciitilde_greater {
    # Contextual substitution for '<~>' not followed by '>' or preceded by '<'.
    ignore sub less less' asciitilde greater;
    ignore sub less' asciitilde greater greater;
    sub less' asciitilde' greater' by less_asciitilde_greater;
} less_asciitilde_greater;

lookup less_asciitilde {
    # Contextual substitution for '<~' not followed by '>' or preceded by '<'.
    ignore sub less less' asciitilde;
    ignore sub less' asciitilde greater;
    sub less' asciitilde' by less_asciitilde;
} less_asciitilde;

lookup asciitilde_greater {
    # Contextual substitution for '~>' not followed by '>' or preceded by '<'.
    ignore sub asciitilde' greater greater;
    ignore sub less asciitilde' greater;
    sub asciitilde' greater' by asciitilde_greater;
} asciitilde_greater;














lookup ss03_EAW {
    sub less_hyphen_hyphen_greater by emptyAdvanceWidth emptyAdvanceWidth emptyAdvanceWidth less_hyphen_hyphen_greater;
    sub less_exclam_hyphen_hyphen by emptyAdvanceWidth emptyAdvanceWidth emptyAdvanceWidth less_exclam_hyphen_hyphen;
    sub less_hyphen_hyphen by emptyAdvanceWidth emptyAdvanceWidth less_hyphen_hyphen;
    sub hyphen_hyphen_greater by emptyAdvanceWidth emptyAdvanceWidth hyphen_hyphen_greater;
    sub less_hyphen_greater by emptyAdvanceWidth emptyAdvanceWidth less_hyphen_greater;
    sub less_asciitilde_asciitilde by emptyAdvanceWidth emptyAdvanceWidth less_asciitilde_asciitilde;
    sub asciitilde_asciitilde_greater by emptyAdvanceWidth emptyAdvanceWidth asciitilde_asciitilde_greater;
    sub less_asciitilde_greater by emptyAdvanceWidth emptyAdvanceWidth less_asciitilde_greater;
    sub less_hyphen by emptyAdvanceWidth less_hyphen;
    sub hyphen_greater by emptyAdvanceWidth hyphen_greater;
    sub less_asciitilde by emptyAdvanceWidth less_asciitilde;
    sub asciitilde_greater by emptyAdvanceWidth asciitilde_greater;
} ss03_EAW;";
tag = ss03;
