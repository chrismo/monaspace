@colon = [colon colon_colon colon_colon_colon];

lookupflag IgnoreMarks;

lookup colon_math {
    # Contextual substitution for ':(raised)'.
    sub @math colon' by colon.raised;
    sub colon' @math by colon.raised;
    sub colon' emptyAdvanceWidth @math by colon.raised;
    sub colon' emptyAdvanceWidth emptyAdvanceWidth @math by colon.raised;
} colon_math;

lookup semicolon_check {
    # Contextual substitution for ':(lowered)' when preceded or followed by a semicolon.
    sub colon.raised' semicolon by colon;
    sub semicolon colon.raised' by colon;
} semicolon_check;

lookup colon_raised {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised;

lookup colon_raised2 {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised2;

lookup colon_raised3 {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised3;

lookup colon_raised4 {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised4;

lookup colon_check {
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check;

lookup colon_check2 {
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check2;

lookup colon_check3 {
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check3;


lookup colon_check4 { 
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check4;










lookup colon_colon_colon {
  # Contextual substitution for ':::' not followed or preceded by ':' or ';'.
  ignore sub [colon colon.raised semicolon] colon' colon colon;
  ignore sub colon' colon colon [colon colon.raised semicolon];
  sub colon' colon' colon' by colon_colon_colon;
} colon_colon_colon;

lookup colon_colon {
    # Contextual substitution for '::' not preceded or followed by ':' or ';'.
    ignore sub [colon colon.raised semicolon] colon' colon;
    ignore sub colon' colon [colon colon.raised semicolon];
    sub colon' colon' by colon_colon;
} colon_colon;

lookup ss07_EAW {
    sub colon_colon_colon by emptyAdvanceWidth emptyAdvanceWidth colon_colon_colon;
    sub colon_colon by emptyAdvanceWidth colon_colon;
} ss07_EAW;";
tag = ss07;
},
{
code = "featureNames {
   name \"SS08: Centered Period\"; 
};

lookupflag IgnoreMarks;

lookup period_period_equal {
    # Contextual substitution for '..=' not preceded by '.'.
    ignore sub period period' period' equal;
    sub period' period equal by period.raised;
    sub period.raised period' equal by period.raised;
} period_period_equal;

lookup period_period_hyphen {
    # Contextual substitution for '..-' not preceded by '.'.
    ignore sub period period' period' hyphen;
    sub period' period hyphen by period.raised;
    sub period.raised period' hyphen by period.raised;
} period_period_hyphen;

lookup period_period_less {
    # Contextual substitution for '..<' not preceded by '.'.
    ignore sub period period' period' less;
    sub period' period less by period.raised;
    sub period.raised period' less by period.raised;
} period_period_less;

lookup period_hyphen {
    # Contextual substitution for '.-' not preceded by '.'.
    ignore sub period period' hyphen;
    sub period' hyphen by period.raised;
} period_hyphen;

lookup period_equal {
    # Contextual substitution for '.=' not preceded by '.'.
    ignore sub period period' equal;
    sub period' equal by period.raised;
} period_equal;







lookup period_period {
    # Contextual substitution for '..' not preceded or followed by '.'.
    ignore sub period period' period;
    ignore sub period' period period;
    sub period' period' by period_period;
} period_period;

lookup ss08_EAW {
    sub period_period by emptyAdvanceWidth period_period;
} ss08_EAW;";
tag = ss08;
},
{
code = "featureNames {
   name \"SS09: Double Arrows\"; 
};

lookupflag IgnoreMarks;

lookup less_equal_equal_greater {
    # Contextual substitution for '<==>' not followed by '>' or preceded by '<'.
    ignore sub less' equal equal greater greater;
    ignore sub less less' equal equal greater;
    sub less' equal' equal' greater' by less_equal_equal_greater;
    sub less' emptyAdvanceWidth' equal_equal' greater' by less_equal_equal_greater;
} less_equal_equal_greater;

lookup less_equal_equal {
    # Contextual substitution for '<==' not followed by '=' or preceded by '<'.
    ignore sub less' equal equal equal;
    ignore sub less' emptyAdvanceWidth equal_equal equal;
    ignore sub less less' equal equal;
    ignore sub less less' equal_equal;
    sub less' equal' equal' by less_equal_equal;
    sub less' emptyAdvanceWidth' equal_equal' by less_equal_equal;
} less_equal_equal;

lookup equal_equal_greater {
    # Contextual substitution for '==>' not preceded by '=' or followed by '>'.
    ignore sub equal equal' equal greater;
    ignore sub equal emptyAdvanceWidth equal_equal' greater;
    ignore sub equal' equal greater greater;
    ignore sub equal_equal' greater greater;
    sub equal' equal' greater' by equal_equal_greater;
    sub emptyAdvanceWidth' equal_equal' greater' by equal_equal_greater;
} equal_equal_greater;

lookup less_less_equal {
    # Contextual substitution for '<<=' not followed by '=' or preceded by '<'.
    ignore sub less' less equal equal;
    ignore sub less less' less equal;
    sub less' less' equal' by less_less_equal;
} less_less_equal;

lookup equal_greater_greater {
    # Contextual substitution for '=>>' not preceded by '=' or followed by '>'.
    ignore sub equal equal' greater greater;
    ignore sub equal' greater greater greater;
    sub equal' greater' greater' by equal_greater_greater;
} equal_greater_greater;

lookup equal_less_less {
    # Contextual substitution for '=<<' not preceded by '=' or followed by '<'.
    ignore sub less' less equal equal;
    ignore sub less less' less equal;
    sub equal' less' less' by equal_less_less;
} equal_less_less;

lookup greater_greater_equal {
    # Contextual substitution for '>>=' not followed by '=' or preceded by '>'.
    ignore sub greater greater' greater equal;
    ignore sub greater' greater equal equal;
    sub greater' greater' equal' by greater_greater_equal;
} greater_greater_equal;

lookup less_less {
    # Contextual substitution for '<<' not followed or preceded by '<'.
    ignore sub less less' less;
    ignore sub less' less less;
    sub less' less' by less_less;
} less_less;

lookup greater_greater {
    # Contextual substitution for '>>' not followed or preceded by '>'.
    ignore sub greater greater' greater;
    ignore sub greater' greater greater;
    sub greater' greater' by greater_greater;
} greater_greater;

lookup less_equal_greater {
    # Contextual substitution for '<=>' not followed by '>' or preceded by '<'.
    ignore sub less less' equal greater;
    ignore sub less' equal greater greater;
    sub less' equal' greater' by less_equal_greater;
} less_equal_greater;

lookup equal_greater {
    # Contextual substitution for '=>' not preceded by '=' and not part of '<=>'.
    ignore sub less equal' greater;
    ignore sub equal equal' greater;
    ignore sub equal' greater greater;
    sub equal' greater' by equal_greater;
} equal_greater;





lookup ss09_EAW {
    sub less_equal_equal_greater by emptyAdvanceWidth emptyAdvanceWidth emptyAdvanceWidth less_equal_equal_greater;
    sub less_equal_equal by emptyAdvanceWidth emptyAdvanceWidth less_equal_equal;
    sub equal_equal_greater by emptyAdvanceWidth emptyAdvanceWidth equal_equal_greater;
    sub less_less_equal by emptyAdvanceWidth emptyAdvanceWidth less_less_equal;
    sub equal_greater_greater by emptyAdvanceWidth emptyAdvanceWidth equal_greater_greater;
    sub equal_less_less by emptyAdvanceWidth emptyAdvanceWidth equal_less_less;
    sub greater_greater_equal by emptyAdvanceWidth emptyAdvanceWidth greater_greater_equal;
    sub less_less by emptyAdvanceWidth less_less;
    sub greater_greater by emptyAdvanceWidth greater_greater;
    sub less_equal_greater by emptyAdvanceWidth emptyAdvanceWidth less_equal_greater;
    sub equal_greater by emptyAdvanceWidth equal_greater;
} ss09_EAW;";
tag = ss09;
