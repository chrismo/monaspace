sub de-cy.loclSRB by de-cy.loclSRB.italic;
sub ii-cy.loclSRB by ii-cy.loclSRB.italic;
sub pe-cy.loclSRB by pe-cy.loclSRB.italic;
sub te-cy.loclSRB by te-cy.loclSRB.italic;
";
tag = ital;
