{
code = "featureNames {
   name \"SS04: HTML Tags\"; 
};

lookupflag IgnoreMarks;

lookup less_slash_greater {
    # Contextual substitution for '</>' not followed by '>' or preceded by '<'.
    ignore sub less less' slash greater;
    ignore sub less' slash greater greater;
    sub less' slash' greater' by less_slash_greater;
} less_slash_greater;

lookup less_slash {
    # Contextual substitution for '</' not followed by '>' or '/', or preceded by '<'.
    ignore sub less less' slash;
    ignore sub less' slash greater;
    ignore sub less' slash slash;
    sub less' slash' by less_slash;
} less_slash;

lookup slash_greater {
    # Contextual substitution for '/>' not followed by '>' or preceded by '<' or '/'.
    ignore sub slash' greater greater;
    ignore sub slash slash' greater;
    ignore sub less slash' greater;
    sub slash' greater' by slash_greater;
} slash_greater;

lookup less_greater {
    # Contextual substitution for '<>' not followed by '>' or preceded by '<'.
    ignore sub less less' greater;
    ignore sub less' greater greater;
    sub less' greater' by less_greater;
} less_greater;












lookup ss04_EAW {
    sub less_slash_greater by emptyAdvanceWidth emptyAdvanceWidth less_slash_greater;
    sub less_slash by emptyAdvanceWidth less_slash;
    sub slash_greater by emptyAdvanceWidth slash_greater;
    sub less_greater by emptyAdvanceWidth less_greater;
} ss04_EAW;
";
